#!/bin/sh
# devkitw: fetch the devkit commit pinned in ./devkit.toml into a per-user
# cache, point ./.devkit at it and print its path. A project commits this file
# verbatim; `./devkitw self-check` notices a copy that has drifted.
# Usage, from the project root: ./devkitw [path | self-check]
set -eu

die() {
  echo "devkitw: $*" >&2
  exit 1
}

case $#:${1-} in
  0: | 1:path | 1:self-check) ;;
  *)
    echo "devkitw: unknown argument '$*'; usage: devkitw [path|self-check]" >&2
    exit 2
    ;;
esac
[ -f devkit.toml ] || die "no devkit.toml in $PWD; run from the project root"

# key NAME: the double-quoted value of NAME in the [devkit] table, else empty.
key() {
  s='[[:space:]]*'
  sed -n -e "/^$s\[devkit\]/,/^$s\[/!d" \
    -e "s/^$s$1$s=$s\"\([^\"]*\)\".*/\1/p" devkit.toml | head -n 1
}
url=$(key url) mirror=$(key mirror) version=$(key version) commit=$(key commit)
if [ -z "$url" ] || [ -z "$version" ]; then
  die "devkit.toml: the [devkit] table needs url and version"
fi
printf '%s\n' "$commit" | grep -qx '[0-9a-f]\{40\}' ||
  die "devkit.toml: commit must be 40 lowercase hex characters"
[ -L .devkit ] || [ ! -e .devkit ] ||
  die ".devkit exists and is not a symlink; move it out of the way"

root=${XDG_CACHE_HOME:-$HOME/.cache}/devkit
case $root in /*) ;; *) die "cache root $root is not an absolute path" ;; esac
dir=$root/$commit mark=.devkit-commit

if [ "$(cat "$dir/$mark" 2>/dev/null)" != "$commit" ]; then
  [ ! -e "$dir" ] || die "$dir has no $mark; remove it and retry"
  # Never touch a calling git hook's repository (GIT_DIR, GIT_INDEX_FILE, ...).
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars)
  export GIT_TERMINAL_PROMPT=0 # fail rather than ask for credentials
  mkdir -p "$root"
  tmp=$(mktemp -d "$root/.tmp.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  trap 'exit 1' HUP INT TERM
  git -C "$tmp" init -q
  for remote in "$url" ${mirror:+"$mirror"}; do
    git -C "$tmp" fetch -q --depth 1 -- "$remote" "refs/tags/$version" \
      2>/dev/null && break
  done
  got=$(git -C "$tmp" rev-parse -q --verify 'FETCH_HEAD^{commit}') ||
    die "cannot fetch tag $version from $url${mirror:+ or $mirror}"
  [ "$got" = "$commit" ] || die "tag $version is $got, not the pinned $commit"
  git -C "$tmp" checkout -q "$commit"
  rm -rf "$tmp/.git"
  echo "$commit" >"$tmp/$mark"
  mv "$tmp" "$dir"
  rm -rf "${dir:?}/${tmp##*/}" # a concurrent run won: mv nested ours in it
fi

[ "$(readlink .devkit 2>/dev/null)" = "$dir" ] || {
  rm -f .devkit
  ln -s "$dir" .devkit
}

if [ "${1-}" = self-check ]; then
  cmp -s devkitw "$dir/devkitw" ||
    die "./devkitw differs from devkit $version; copy $dir/devkitw over it"
else
  printf '%s\n' "$dir"
fi
