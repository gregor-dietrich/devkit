<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Shared PMD Rules"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD rules shared by every project that consumes devkit: the categories
        below minus their excludes, at PMD's default thresholds unless a rule below sets
        one; a comment beside an exclude names a gate that covers its defect, or the
        construct it fires on.</description>

    <!-- Error Prone: category enabled, minus the excludes below -->
    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidDuplicateLiterals" />
        <exclude name="AvoidFieldNameMatchingMethodName" />
        <exclude name="AvoidLiteralsInIfCondition" />
        <!-- SpotBugs reports a stream opened and never closed (OBL_UNSATISFIED_OBLIGATION,
             OS_OPEN_STREAM); PMD's also fires on container-owned resources such as a
             JAX-RS Response -->
        <exclude name="CloseResource" />
        <exclude name="AssignmentInOperand" />
        <exclude name="DoNotTerminateVM" />
        <exclude name="TestClassWithoutTestCases" />
        <!-- javac -Xlint:serial under -Werror (the parent pom) fails the build on it -->
        <exclude name="MissingSerialVersionUID" />
        <exclude name="NullAssignment" />
    </rule>

    <!-- Best Practices: category enabled, minus the excludes below -->
    <rule ref="category/java/bestpractices.xml">
        <exclude name="AbstractClassWithoutAbstractMethod" />
        <exclude name="AccessorMethodGeneration" />
        <exclude name="ArrayIsStoredDirectly" />
        <!-- Checkstyle's RegexpSinglelineJava.ConsoleOutput (checkstyle.xml) fails the build on it -->
        <exclude name="AvoidPrintStackTrace" />
        <exclude name="AvoidReassigningParameters" />
        <exclude name="ConstantsInInterface" />
        <exclude name="ForLoopCanBeForeach" />
        <exclude name="GuardLogStatement" />
        <exclude name="ExhaustiveSwitchHasDefault" />
        <exclude name="JUnit5TestShouldBePackagePrivate" />
        <!-- Checkstyle's RegexpSinglelineJava.ConsoleOutput (checkstyle.xml) fails the build on it -->
        <exclude name="SystemPrintln" />
        <exclude name="UnitTestShouldUseTestAnnotation" />
        <exclude name="UnitTestContainsTooManyAsserts" />
        <!-- configured below -->
        <exclude name="UnitTestShouldIncludeAssert" />
        <exclude name="LooseCoupling" />
        <exclude name="MethodReturnsInternalArray" />
        <!-- Error Prone's MissingOverride under -Werror fails the build on it -->
        <exclude name="MissingOverride" />
        <!-- Checkstyle's MultipleVariableDeclarations (checkstyle.xml) fails the build on it -->
        <exclude name="OneDeclarationPerLine" />
        <exclude name="ReplaceEnumerationWithIterator" />
        <exclude name="ReplaceHashtableWithMap" />
        <exclude name="ReplaceVectorWithList" />
        <exclude name="UnitTestAssertionsShouldIncludeMessage" />
        <exclude name="UseCollectionIsEmpty" />
        <exclude name="UseVarargs" />
    </rule>

    <!--
        UnitTestShouldIncludeAssert is on with PMD's defaults (assert*, verify*, ...). A
        project names its own assertion helpers, e.g. a REST Assured terminal call or a
        test utility that asserts, in the pmd.extraAssertMethodNames property in the
        <properties> of the root pom, or of a module that needs its own. The parent filters that value in, as a
        comma-separated list, when it copies this file to the build directory; PMD reads
        the copy.
    -->
    <rule ref="category/java/bestpractices.xml/UnitTestShouldIncludeAssert">
        <properties>
            <property name="extraAssertMethodNames"
                value="${pmd.extraAssertMethodNames}" />
        </properties>
    </rule>

    <!-- Design: category enabled, minus the excludes below -->
    <rule ref="category/java/design.xml">
        <exclude name="AvoidCatchingGenericException" />
        <exclude name="AvoidDeeplyNestedIfStmts" />
        <exclude name="ExceptionAsFlowControl" />
        <exclude name="LoosePackageCoupling" />
        <exclude name="CouplingBetweenObjects" />
        <exclude name="DataClass" />
        <exclude name="ExcessiveImports" />
        <exclude name="ExcessiveParameterList" />
        <exclude name="GodClass" />
        <exclude name="LawOfDemeter" />
        <exclude name="NcssCount" />
        <exclude name="SignatureDeclareThrowsException" />
        <exclude name="SimplifiedTernary" />
        <exclude name="SingularField" />
        <exclude name="SwitchDensity" />
        <exclude name="UseObjectForClearerAPI" />
    </rule>

    <!-- TooManyMethods and TooManyFields stay raised: at PMD's defaults they fire on test
         classes, DTOs, entities and views. The complexity rules run at PMD's defaults. -->
    <rule ref="category/java/design.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="40" />
        </properties>
    </rule>
    <rule ref="category/java/design.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="40" />
        </properties>
    </rule>

    <!-- Code Style: category enabled, minus the excludes below -->
    <rule ref="category/java/codestyle.xml">
        <exclude name="AtLeastOneConstructor" />
        <exclude name="CallSuperInConstructor" />
        <exclude name="ClassNamingConventions" />
        <exclude name="CommentDefaultAccessModifier" />
        <exclude name="ConfusingTernary" />
        <exclude name="LambdaCanBeMethodReference" />
        <!-- configured below -->
        <exclude name="LinguisticNaming" />
        <exclude name="FieldDeclarationsShouldBeAtStartOfClass" />
        <exclude name="ForLoopShouldBeWhileLoop" />
        <exclude name="LocalVariableCouldBeFinal" />
        <exclude name="LongVariable" />
        <exclude name="MethodArgumentCouldBeFinal" />
        <exclude name="MethodNamingConventions" />
        <exclude name="OnlyOneReturn" />
        <exclude name="PrematureDeclaration" />
        <exclude name="ShortClassName" />
        <exclude name="ShortMethodName" />
        <exclude name="ShortVariable" />
        <exclude name="TooManyStaticImports" />
        <exclude name="UnnecessaryCast" />
        <!-- Checkstyle's RegexpSinglelineJava.FullyQualifiedName (checkstyle.xml) fails
             the build on a qualified name under the package roots it lists; PMD's also fires
             on a static call qualified by an inherited class (Panache's Entity.find) -->
        <exclude name="UnnecessaryFullyQualifiedName" />
        <exclude name="UnnecessaryModifier" />
        <exclude name="UnnecessaryReturn" />
        <exclude name="UnnecessarySemicolon" />
        <exclude name="UseDiamondOperator" />
        <exclude name="UseExplicitTypes" />
        <exclude name="UselessParentheses" />
        <exclude name="UselessQualifiedThis" />
    </rule>

    <!--
        LinguisticNaming, narrowed to the checks that hold here rather than switched
        off entirely. See the property comments below.
    -->
    <rule ref="category/java/codestyle.xml/LinguisticNaming">
        <properties>
            <!-- The field/variable check is the part that earns its keep here (it catches
                 a Map named isSomethingFlags). The getter and transform-method checks are
                 switched off because they fire on the test naming convention rather than
                 on real antipatterns: a test named methodUnderTest_expectedOutcome reads
                 as a getter (getAccountBalance_restrictsToDateRange) or as a transform
                 method (toLongCountMap_shouldMapCorrectly) and is void by definition. -->
            <property name="checkGetters" value="false" />
            <property name="checkPrefixedTransformMethods" value="false" />
        </properties>
    </rule>

    <!-- Performance: category enabled, minus the excludes below -->
    <rule ref="category/java/performance.xml">
        <exclude name="AddEmptyString" />
        <exclude name="AppendCharacterWithChar" />
        <exclude name="AvoidFileStream" />
        <exclude name="AvoidInstantiatingObjectsInLoops" />
        <exclude name="ConsecutiveAppendsShouldReuse" />
        <exclude name="ConsecutiveLiteralAppends" />
        <exclude name="InefficientEmptyStringCheck" />
        <exclude name="InsufficientStringBufferDeclaration" />
        <exclude name="OptimizableToArrayCall" />
        <exclude name="RedundantFieldInitializer" />
        <exclude name="StringInstantiation" />
        <exclude name="StringToString" />
        <exclude name="TooFewBranchesForSwitch" />
        <exclude name="UseArrayListInsteadOfVector" />
        <exclude name="UseArraysAsList" />
        <exclude name="UseIndexOfChar" />
        <exclude name="UseStringBufferForStringAppends" />
        <exclude name="UseStringBufferLength" />
        <exclude name="UselessStringValueOf" />
    </rule>

    <!-- Multithreading: category enabled, minus the excludes below -->
    <rule ref="category/java/multithreading.xml">
        <exclude name="AvoidSynchronizedAtMethodLevel" />
        <exclude name="AvoidSynchronizedStatement" />
        <exclude name="AvoidUsingVolatile" />
        <exclude name="DoNotUseThreads" />
        <exclude name="UseConcurrentHashMap" />
    </rule>

    <!-- Security: category enabled -->
    <rule ref="category/java/security.xml" />
</ruleset>
