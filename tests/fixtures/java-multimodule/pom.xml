<?xml version="1.0" encoding="UTF-8"?>
<!-- devkit test fixture: a plain Maven two-module build. The gate plugins read devkit's shared
     configs through the .devkit link; plugin versions follow the multi-module source project. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>devkit.fixture</groupId>
  <artifactId>java-multimodule</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <checkstyle.version>14.3.0</checkstyle.version>
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <compiler-plugin.version>3.16.0</compiler-plugin.version>
    <eclipse-formatter.version>4.40</eclipse-formatter.version>
    <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
    <junit.version>6.1.3</junit.version>
    <pmd-plugin.version>3.28.0</pmd-plugin.version>
    <spotbugs-plugin.version>4.10.4.1</spotbugs-plugin.version>
    <spotless-plugin.version>3.10.3</spotless-plugin.version>
    <surefire-plugin.version>3.6.0</surefire-plugin.version>
  </properties>

  <modules>
    <module>core</module>
    <module>app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-plugin.version}</version>
        <configuration>
          <java>
            <eclipse>
              <file>${maven.multiModuleProjectDirectory}/.devkit/java/config/eclipse-formatter.xml</file>
              <version>${eclipse-formatter.version}</version>
              <!-- download.eclipse.org suffers recurring outages; provision P2 from a mirror -->
              <p2Mirrors>
                <p2Mirror>
                  <prefix>https://download.eclipse.org/</prefix>
                  <url>https://ftp.halifax.rwth-aachen.de/eclipse/</url>
                </p2Mirror>
              </p2Mirrors>
            </eclipse>
            <importOrder>
              <order>java,javax,org,com,#</order>
            </importOrder>
            <removeUnusedImports />
          </java>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/.devkit/java/config/checkstyle.xml</configLocation>
          <propertyExpansion>
            org.checkstyle.google.suppressionfilter.config=${maven.multiModuleProjectDirectory}/checkstyle-suppressions.xml</propertyExpansion>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs-plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd-plugin.version}</version>
        <configuration>
          <minimumTokens>65</minimumTokens>
          <targetJdk>${maven.compiler.release}</targetJdk>
          <includeTests>true</includeTests>
          <linkXRef>false</linkXRef>
          <rulesets>
            <ruleset>${maven.multiModuleProjectDirectory}/.devkit/java/config/pmd-ruleset.xml</ruleset>
          </rulesets>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
